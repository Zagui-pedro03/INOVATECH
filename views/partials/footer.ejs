
<style>
.footer {
  background: #300064;
  color: #ffffff;
  padding: 60px 8% 0;
  font-family: "Reddit Sans", sans-serif;
  width: 100%;
  box-sizing: border-box;
  position: absolute;
}

/* CONTEÚDO PRINCIPAL */

.footer-container {
  max-width: 1400px;
  margin: 0 auto;

  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
  gap: 55px;
  padding-bottom: 50px;
}

/* COLUNAS */

.footer-coluna {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14px;
}

.footer-coluna h3 {
  font-size: 19px;
  font-weight: 600;
  margin: 0 0 12px;
  color: #ffffff;
}

.footer-coluna p {
  font-size: 15px;
  line-height: 1.7;
  color: #cbb9e5;
  margin: 0;
}

/* LOGO */

.footer-logo {
  width: 250px;
  max-width: 100%;
  height: auto;
}

.footer-marca p {
  max-width: 290px;
}

/* LINKS */

.footer-coluna a:not(.footer-botao) {
  text-decoration: none;
  color: #e8def5;
  font-size: 15px;
  transition: color 0.3s;
}

.footer-coluna a:not(.footer-botao):hover {
  color: #af80ff;
}

/* REDES SOCIAIS */

.footer-redes {
  display: flex;
  gap: 14px;
  margin-top: 15px;
}

.footer-redes a {
  width: 42px;
  height: 42px;
  border-radius: 50%;

  background: #4b1680;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 20px !important;
  color: white !important;

  transition: 0.3s;
}

.footer-redes a:hover {
  background: #8650ff;
  transform: translateY(-4px);
}

/* ORGANIZADORES */

.footer-organizadores p {
  max-width: 280px;
}

/* BOTÃO */

.footer-botao {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;

  background: #8650ff;
  color: white;

  padding: 15px 25px;
  margin-top: 10px;

  border-radius: 13px;
  font-size: 16px;
  font-weight: 600;

  text-decoration: none;

  transition: 0.3s;
}

.footer-botao:hover {
  background: #a179ff;
  transform: translateY(-3px);
  box-shadow: 0 5px 20px #00000030;
}

/* PARTE INFERIOR */

.footer-inferior {
  max-width: 1400px;
  margin: 0 auto;

  border-top: 1px solid #65318f;
  padding: 25px 0;

  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.footer-inferior p {
  color: #cbb9e5;
  font-size: 13px;
  margin: 0;
}

.footer-inferior span {
  color: #a179ff;
  font-size: 22px;
}

/* RESPONSIVIDADE */

@media (max-width: 1000px) {

  .footer-container {
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
  }

}

@media (max-width: 600px) {

  .footer {
    padding: 40px 6% 0;
  }

  .footer-container {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .footer-logo {
    width: 210px;
  }

  .footer-inferior {
    flex-direction: column;
    text-align: center;
  }

}

</style>


<link rel="preconnect" href="https://fonts.googleapis.com" />
