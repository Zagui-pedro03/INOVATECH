<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sala-geral: <%=id %></title>
    
    <link rel="icon" type="image/png" href="/assets/img/favicon/icone_2.png">
     <link rel="stylesheet" href="/css/sala-geral.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Reddit+Sans:ital,wght@0,200..900;1,200..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet"
    >
</head>
<body>
    <div class="container">
        <div class="area-superior">
            <div>
            <h2 id="nomeSala"></h2>
            <h3 id="categoriaSala"></h3>
            <p id="idSala" style="display: none;"><%=id %></p>
            </div>
            <div class="img">
            <img src="/assets/img/close-option.png" width="30" height="30" alt="">
            </div>
        </div>
        <div class="area-lateral">
            <ul id="canais">
                <li id="geral" class="selected"><a href="/salas/sala-geral/<%=id %>">Geral</a></li>
                <li id="avisos"><a href="/salas/sala-avisos/<%=id %>">Avisos</a></li>
            </ul>
        </div>
        <div class="area-mensagens">
            <div class="visor-mensagens"></div>
            <div id="escrever-mensagem">
                <form id="formulario">
                <textarea
                id="msg"
                placeholder="Escreva uma mensagem"
                required
                ></textarea>
                <button id="enviarMsg" type="submit"><img src="/assets/img/send_icone.png" width="30" alt=""></button>
                </form>
            </div>
        </div>
    </div>

    

    <script type="module" src="/js/sala-geral.js"></script>
</body>
</html>