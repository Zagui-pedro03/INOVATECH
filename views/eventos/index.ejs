<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Eventos</title>

    <link rel="icon" type="image/png" href="/assets/img/favicon/icone_2.png">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/homeEventos.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Reddit+Sans:ital,wght@0,200..900;1,200..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet"
    >
</head>

<body>

    <%- include("../partials/header") %>
      <div class="pesquisarEvento">
        <form class="input-pesquisa">
        <input type="text" id="txtPesquisa">
        <button id="enviarPesquisa" class="img-pesquisa"><img src="/assets/img/pesquisa_icone.png" width="15" height="15" alt=""></button>
        </form>
      </div>
    <div id="semEventos" class="sem-eventos" style="display: none;">

    <div class="icone-sem-eventos">
        <span><img src="/assets/img/calendary_icone.png" width="50" height="50"></span>
    </div>

    <h2>Nenhum evento por enquanto</h2>

    <p>
        Ainda não há eventos disponíveis.<br>
        Que tal criar o primeiro e reunir a comunidade?
    </p>

    <a href="/eventos/criar-evento" class="btn-criar-evento">
        + Criar evento
    </a>

</div>
     <main class="eventos-container" id="eventos-container">
    </main>

    
    <div class="opcoes criacao" id="criacao">
        <a href="/eventos/criar-evento" id="criar">Criar evento</a>
        <img src="/assets/img/add_icone.png" width="30" alt="">
    </div>
    <div class="opcoes mensagem" id="mensagem">
        <a href="/eventos/solicitacoes" id="solicitacao">Solicitações</a>
        <img src="/assets/img/mensagem.png" width="30" alt="">
    </div>
    <%- include("../partials/footer") %>

    

    <script type="module" src="/js/homeEventos.js"></script>
    <script>

        let optionCreate = document.getElementById("criacao")

        let optionMessage = document.getElementById("mensagem")

        optionCreate.addEventListener("click", () => {
            window.location.href = "/eventos/criar-evento"
        })

        optionMessage.addEventListener("click", () => {
            window.location.href = "/eventos/solicitacoes"
        })
    </script>
</body>
</html>